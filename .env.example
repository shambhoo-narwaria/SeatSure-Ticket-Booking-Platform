# PostgreSQL Configuration
POSTGRES_DB=seatsure
POSTGRES_USER=seatsure_app
POSTGRES_PASSWORD=seatsure_dev_password
DATABASE_URL=jdbc:postgresql://localhost:5432/seatsure
DATABASE_USERNAME=seatsure_app
DATABASE_PASSWORD=seatsure_dev_password

# Backend Configuration
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:5173
HOLD_DURATION_SECONDS=300
SPRING_PROFILES_ACTIVE=local

# Security (Phase 2)
JWT_SECRET=supersecretkeyforseatsurelocaldevelopmentonlyminimum32characterslong!
JWT_EXPIRATION_MS=86400000

# Payment Gateway (Local mock implementation)
PAYMENT_PROVIDER=MOCK
